{
  "name": "ajisai-mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bounded Ajisai computation and contract tools for MCP-compatible AI agents.",
  "engines": { "node": ">=20" },
  "files": ["index.js", "result.schema.json", "README.md", "golden/cases.json", "eval.js", "score-traces.js", "score-repairs.js", "eval/*.json"],
  "bin": { "ajisai-mcp-server": "index.js" },
  "scripts": { "start": "node index.js", "selftest": "node selftest.js", "test:pack": "node pack-smoke.js", "eval": "node eval.js", "eval:traces": "node score-traces.js eval/reference-traces.json --require-perfect", "eval:repairs": "node score-repairs.js eval/reference-repair-traces.json --require-perfect" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.18.0"
  }
}
