{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "successful exact rational",
      "source": "[ 1 ] [ 2 ] +",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "[ 3/1 ]",
        "/errorFlowTrace": []
      }
    },
    {
      "name": "reason-carrying NIL is a successful value",
      "source": "1 0 /",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "NIL",
        "/errorFlowTrace/0/kind": "nilProduced",
        "/errorFlowTrace/0/word": "DIV",
        "/errorFlowTrace/0/absence/reason": "divisionByZero"
      }
    },
    {
      "name": "language ERROR remains a structured tool result",
      "source": "FROBNICATE",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/aiDiagnostic/kind": "unknownWord",
        "/errorFlowTrace/0/kind": "wordError",
        "/diagnosis/nextChecks/0/code": "checkSpelling",
        "/diagnosis/candidates": []
      }
    },
    {
      "name": "a misspelled Word names its likely correction",
      "source": "[ 1 2 3 ] LENGHT",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/diagnosis/candidates/0": "LENGTH"
      }
    },
    {
      "name": "a misspelled user Word is matched against the live dictionary",
      "source": "{ [ 2 ] * } 'DOUBLE' DEF [ 3 ] DOUBEL",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/diagnosis/candidates/0": "DOUBLE"
      }
    },
    {
      "name": "algebraic result keeps its normal form",
      "source": "[ 2 ] SQRT",
      "expect": {
        "/status": "ok",
        "/stack/0/value/0/semantics/approximate": true,
        "/stack/0/value/0/semantics/exactTerms/0/numerator": "1",
        "/stack/0/value/0/semantics/exactTerms/0/denominator": "1",
        "/stack/0/value/0/semantics/exactTerms/0/radicand": "2"
      }
    },
    {
      "name": "execution budget exhaustion is a language ERROR",
      "source": "{\n{ [ 0 ] > | [ 1 ] - DOWN }\n{ IDLE | [ 'done' ] } COND\n} 'DOWN' DEF\n200000 DOWN",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "resourceLimit",
        "/aiDiagnostic/kind": "executionLimitExceeded",
        "/errorFlowTrace/0/kind": "wordError",
        "/errorFlowTrace/0/word": "DOWN",
        "/diagnosis/resourceLimit/resource": "executionSteps"
      }
    },
    {
      "name": "agent materialization ceiling is a reason-carrying NIL",
      "source": "[ 0 100001 ] RANGE",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "NIL",
        "/stack/0/semantics/absence/reason": "spaceExhausted",
        "/errorFlowTrace/0/absence/reason": "spaceExhausted"
      },
      "hostDivergence": {
        "playground": "succeeds, materializing 100002 elements",
        "why": "The browser playground applies the interpreter's default RuntimeLimits (max_materialized_elements = 1,000,000); this profile applies LOCAL_AGENT_RUNTIME_LIMITS (100,000). Both are correct for their host: SPEC 2.5 makes limits a safety control rather than value semantics, so a conforming host chooses its own. Recorded here so the divergence is a documented decision rather than a surprise for anyone who prototypes in the playground and runs through MCP. See docs/dev/mcp-host-profiles.md."
      }
    }
  ]
}
