{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "successful exact rational",
      "source": "[ 1 ] [ 2 ] +",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "[ 3/1 ]",
        "/errorFlowTrace": []
      }
    },
    {
      "name": "reason-carrying NIL is a successful value",
      "source": "1 0 /",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "NIL",
        "/errorFlowTrace/0/kind": "nilProduced",
        "/errorFlowTrace/0/word": "DIV",
        "/errorFlowTrace/0/absence/reason": "divisionByZero"
      }
    },
    {
      "name": "language ERROR remains a structured tool result",
      "source": "FROBNICATE",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/aiDiagnostic/kind": "unknownWord",
        "/errorFlowTrace/0/kind": "wordError",
        "/diagnosis/nextChecks/0/code": "checkSpelling",
        "/diagnosis/candidates": []
      }
    },
    {
      "name": "a misspelled Word names its likely correction",
      "source": "[ 1 2 3 ] LENGHT",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/diagnosis/candidates/0": "LENGTH"
      }
    },
    {
      "name": "a misspelled user Word is matched against the live dictionary",
      "source": "{ [ 2 ] * } 'DOUBLE' DEF [ 3 ] DOUBEL",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/diagnosis/candidates/0": "DOUBLE"
      }
    },
    {
      "name": "algebraic result keeps its normal form",
      "source": "[ 2 ] SQRT",
      "expect": {
        "/status": "ok",
        "/stack/0/value/0/semantics/approximate": true,
        "/stack/0/value/0/semantics/exactTerms/0/numerator": "1",
        "/stack/0/value/0/semantics/exactTerms/0/denominator": "1",
        "/stack/0/value/0/semantics/exactTerms/0/radicand": "2",
        "/stack/0/value/0/semantics/exactDisplay": "sqrt(2)"
      }
    },
    {
      "name": "a scaled algebraic value writes its coefficient",
      "source": "1 2 / SQRT",
      "expect": {
        "/status": "ok",
        "/stack/0/semantics/exactDisplay": "1/2*sqrt(2)",
        "/stack/0/semantics/exactTerms/0/numerator": "1",
        "/stack/0/semantics/exactTerms/0/denominator": "2",
        "/stack/0/semantics/exactTerms/0/radicand": "2"
      }
    },
    {
      "name": "a multi-term algebraic value writes every term",
      "source": "2 SQRT 3 SQRT +",
      "expect": {
        "/status": "ok",
        "/stack/0/semantics/exactDisplay": "sqrt(2) + sqrt(3)",
        "/stack/0/semantics/exactTerms/0/radicand": "2",
        "/stack/0/semantics/exactTerms/1/radicand": "3"
      }
    },
    {
      "name": "a rational carries no algebraic rendering",
      "source": "2 3 / 1 3 / +",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "1/1"
      },
      "expectAbsent": [
        "/stack/0/semantics/exactDisplay",
        "/stack/0/semantics/exactTerms",
        "/stack/0/semantics/approximate"
      ]
    },
    {
      "name": "a vector of rationals carries no algebraic rendering",
      "source": "[ 1 2 3 ] [ 4 5 6 ] +",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "[ 5/1 7/1 9/1 ]"
      },
      "expectAbsent": [
        "/stack/0/semantics/exactDisplay",
        "/stack/0/value/0/semantics/exactDisplay",
        "/stack/0/value/0/semantics/exactTerms"
      ]
    },
    {
      "name": "execution budget exhaustion is a language ERROR",
      "source": "{\n{ [ 0 ] > | [ 1 ] - DOWN }\n{ IDLE | [ 'done' ] } COND\n} 'DOWN' DEF\n200000 DOWN",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "resourceLimit",
        "/aiDiagnostic/kind": "executionLimitExceeded",
        "/errorFlowTrace/0/kind": "wordError",
        "/errorFlowTrace/0/word": "DOWN",
        "/diagnosis/resourceLimit/resource": "executionSteps"
      }
    },
    {
      "name": "agent materialization ceiling is a reason-carrying NIL",
      "source": "[ 0 100001 ] RANGE",
      "expect": {
        "/status": "ok",
        "/stackDisplay/0": "NIL",
        "/stack/0/semantics/absence/reason": "spaceExhausted",
        "/errorFlowTrace/0/absence/reason": "spaceExhausted"
      },
      "hostDivergence": {
        "playground": "succeeds, materializing 100002 elements",
        "why": "The browser playground applies the interpreter's default RuntimeLimits (max_materialized_elements = 1,000,000); this profile applies LOCAL_AGENT_RUNTIME_LIMITS (100,000). Both are correct for their host: SPEC 2.5 makes limits a safety control rather than value semantics, so a conforming host chooses its own. Recorded here so the divergence is a documented decision rather than a surprise for anyone who prototypes in the playground and runs through MCP. See docs/dev/mcp-host-profiles.md."
      }
    },
    {
      "name": "a huge failing stack does not cost the diagnosis",
      "source": "[ 0 99999 ] RANGE LENGHT",
      "expect": {
        "/status": "error",
        "/diagnosis/why": "typoOrUnknownName",
        "/diagnosis/candidates/0": "LENGTH",
        "/stackElided/reason": "errorStackBudget",
        "/stackElided/slots/0/index": 0,
        "/stackElided/slots/0/elements": 100000,
        "/stack/0/type": "vector",
        "/stack/0/elided/reason": "errorStackBudget"
      }
    },
    {
      "name": "a run reports the resources it actually spent",
      "source": "[ 1 20 ] RANGE 1 { * } FOLD",
      "expect": {
        "/status": "ok",
        "/resourceUsage/executionSteps": 22,
        "/resourceUsage/numericWork": 20,
        "/runtimeMetrics/executionSteps": 22
      },
      "comment": "RANGE and FOLD are one step each and the block's `*` runs twenty times: 22. Pinned as an exact number because the defect was a constant — every program reported 0 — so only an exact expectation catches a regression to one."
    }
  ]
}
