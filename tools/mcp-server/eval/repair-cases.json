{
 "schemaVersion": 1,
 "cases": [
  {
   "id": "repair-unknown-word",
   "prompts": {
    "en": "Repair `1 2 AD` using its diagnosis.",
    "ja": "`1 2 AD` を、その診断を使って直してください。"
   },
   "firstAttempt": {
    "expect": {
     "/status": "error",
     "/diagnosis/why": "typoOrUnknownName",
     "/diagnosis/where/word": "AD"
    }
   },
   "repairedAttempt": {
    "expect": {
     "/status": "ok",
     "/stackDisplay/0": "3/1"
    }
   }
  },
  {
   "id": "repair-stack-underflow",
   "prompts": {
    "en": "Repair `1 ADD` using its diagnosis.",
