     "/diagnosis/why": "stackShape",
     "/diagnosis/where/word": "ADD"
    }
   },
   "repairedAttempt": {
    "expect": {
     "/status": "ok",
     "/stackDisplay/0": "3/1"
    }
   }
  },
  {
   "id": "repair-unclosed-vector",
   "prompts": {
    "en": "Repair malformed `[ 1 2` using its diagnosis.",
