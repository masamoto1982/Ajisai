{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "decimal-add",
      "source": "0.1 0.2 +",
      "operation": "add",
      "operands": ["0.1", "0.2"],
      "expectedCanonical": "3/10"
    },
    {
      "id": "large-integer-add",
      "source": "9007199254740993 1 +",
      "operation": "add",
      "operands": ["9007199254740993", "1"],
      "expectedCanonical": "9007199254740994"
    },
    {
      "id": "repeating-fraction",
      "source": "1 3 /",
      "operation": "divide",
      "operands": ["1", "3"],
      "expectedCanonical": "1/3"
    },
    {
      "id": "small-integer-add",
      "source": "1 2 +",
      "operation": "add",
      "operands": ["1", "2"],
      "expectedCanonical": "3"
    },
    {
      "id": "small-integer-modulus",
      "source": "10 4 MOD",
      "operation": "modulo",
      "operands": ["10", "4"],
      "expectedCanonical": "2"
    }
  ]
}
