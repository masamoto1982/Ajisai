{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajisai://schema/result",
  "title": "Ajisai MCP execution result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "status", "mcp"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "stack": {
      "type": "array",
      "items": { "$ref": "#/$defs/protocolNode" }
    },
    "stackDisplay": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "diagnosis": { "type": ["object", "null"] },
    "errorFlowTrace": { "type": "array" },
    "aiDiagnostic": { "type": ["object", "null"] },
    "runtimeMetrics": { "type": "object" },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineVersion", "registryDigest", "limits"],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "registryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceBytes",
            "wallTimeMs",
            "responseBytes",
            "executionSteps",
            "concurrentExecutions"
          ],
          "properties": {
            "sourceBytes": { "type": "integer", "minimum": 1 },
            "wallTimeMs": { "type": "integer", "minimum": 1 },
            "responseBytes": { "type": "integer", "minimum": 1 },
            "executionSteps": { "type": "integer", "minimum": 1 },
            "concurrentExecutions": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "integerString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "$ref": "#/$defs/integerString" },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "exactTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "radicand"],
      "properties": {
        "numerator": { "$ref": "#/$defs/integerString" },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "radicand": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "approximate": { "const": true },
        "exactTerms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exactTerm" }
        }
      }
    },
    "protocolNode": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "value", "displayHint"],
      "properties": {
        "type": { "type": "string" },
        "value": {},
        "displayHint": { "type": "string" },
        "semantics": { "$ref": "#/$defs/semantics" }
      }
    }
  }
}
