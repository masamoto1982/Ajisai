{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajisai-lang.org/spec/tensor-profile.schema.json",
  "title": "Ajisai Tensor Profile contracts",
  "type": "object",
  "required": [
    "schemaVersion",
    "profile",
    "status",
    "dtypes",
    "rounding",
    "implicitCasts",
    "ambientRng",
    "operators"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "pattern": "^org\\.ajisai\\.tensor/[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "stable"
      ]
    },
    "dtypes": {
      "type": "array",
      "items": {
        "enum": [
          "f32",
          "f64",
          "bf16",
          "f16",
          "i8"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rounding": {
      "enum": [
        "nearestTiesToEven"
      ]
    },
    "implicitCasts": {
      "const": false
    },
    "ambientRng": {
      "const": false
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operator"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operator": {
      "type": "object",
      "required": [
        "name",
        "semanticId",
        "inputs",
        "outputs",
        "shape",
        "dtype",
        "determinism",
        "numeric",
        "differentiation",
        "resource"
      ],
      "properties": {
        "name": {
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "semanticId": {
          "pattern": "^tensor\\.[a-z0-9_]+\\.v[1-9][0-9]*$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "determinism": {
          "enum": [
            "bitwise",
            "bounded"
          ]
        },
        "numeric": {
          "type": "object",
          "required": [
            "model",
            "absoluteTolerance",
            "relativeTolerance"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "absoluteTolerance": {
              "type": "number",
              "minimum": 0
            },
            "relativeTolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "differentiation": {
          "type": "object",
          "required": [
            "kind",
            "rule"
          ],
          "properties": {
            "kind": {
              "enum": [
                "vjp",
                "none"
              ]
            },
            "rule": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "resource": {
          "type": "object",
          "required": [
            "compute",
            "memory"
          ],
          "properties": {
            "compute": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
