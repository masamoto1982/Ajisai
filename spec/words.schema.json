{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajisai-lang.org/spec/words.schema.json",
  "title": "Ajisai canonical Word contracts",
  "type": "object",
  "required": [
    "schemaVersion",
    "migration",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "migration": {
      "type": "object",
      "required": [
        "phase",
        "completeInventory"
      ],
      "properties": {
        "phase": {
          "type": "integer",
          "minimum": 3
        },
        "completeInventory": {
          "type": "boolean"
        },
        "betaFreezePhase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "arity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "enum": [
            "control",
            "variable"
          ]
        }
      ]
    },
    "projection": {
      "type": "object",
      "required": [
        "when",
        "reason"
      ],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": [
        "summary",
        "hover",
        "lookup",
        "syntax",
        "role",
        "stackEffect"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "hover": {
          "type": "string",
          "minLength": 1
        },
        "lookup": {
          "type": "string",
          "minLength": 1
        },
        "syntax": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "stackEffect": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "word": {
      "type": "object",
      "required": [
        "name",
        "aliases",
        "family",
        "category",
        "stack",
        "consumption",
        "nilPolicy",
        "projection",
        "errorWhen",
        "partiality",
        "purity",
        "determinism",
        "capability",
        "effects",
        "hostedEffect",
        "interpretationRole",
        "clauses",
        "documentation",
        "executorKey"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?:[A-Z][A-Z0-9@?-]*(?:@[A-Z][A-Z0-9@?-]*)?|>[A-Z][A-Z0-9@?-]*)$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "family": {
          "enum": [
            "booleanLogic",
            "comparison",
            "exactArithmetic",
            "collection",
            "higherOrder",
            "text",
            "control",
            "absence",
            "stackModifier",
            "dictionary",
            "output",
            "reflection"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "object",
          "required": [
            "inputs",
            "outputs"
          ],
          "properties": {
            "inputs": {
              "$ref": "#/$defs/arity"
            },
            "outputs": {
              "$ref": "#/$defs/arity"
            }
          },
          "additionalProperties": false
        },
        "consumption": {
          "enum": [
            "none",
            "eat",
            "retain",
            "conditional"
          ]
        },
        "nilPolicy": {
          "enum": [
            "preserveReason",
            "consumeNil",
            "rejectNil",
            "passthrough",
            "inspectNil",
            "createsNil",
            "passthroughThenProject"
          ]
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "errorWhen": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "partiality": {
          "type": "string",
          "enum": [
            "total",
            "partial",
            "projecting"
          ]
        },
        "acceptedDomain": {
          "description": "The shape of operand the Word accepts. `partiality` says what happens to an operand the Word accepts; this says which operands those are, and the two together are what a reader needs before calling it. Omitted where the Word takes whatever its family takes.",
          "type": "string",
          "enum": [
            "scalar",
            "numeric",
            "flatNumericVector",
            "vector",
            "text"
          ]
        },
        "purity": {
          "enum": [
            "pure",
            "conditional",
            "observational",
            "effectful"
          ]
        },
        "determinism": {
          "enum": [
            "deterministic",
            "stateRelative",
            "hostRelative"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "hostedEffect": {
          "type": "string",
          "minLength": 1
        },
        "interpretationRole": {
          "enum": [
            "scalar",
            "text",
            "truthValue",
            "vector",
            "nil",
            "unassigned"
          ]
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^LANG\\."
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "documentation": {
          "$ref": "#/$defs/documentation"
        },
        "executorKey": {
          "type": "string",
          "pattern": "^(?:[A-Z][A-Za-z0-9]*|[a-z][a-z0-9_]*::[a-z][a-z0-9_]*)$"
        },
        "vocabularyTier": {
          "enum": [
            "kernel",
            "standard"
          ]
        },
        "standardKind": {
          "enum": [
            "shorthand",
            "namedPattern",
            "algorithm",
            "operational"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "vocabularyTier": {
                "const": "standard"
              }
            },
            "required": [
              "vocabularyTier"
            ]
          },
          "then": {
            "required": [
              "standardKind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "vocabularyTier": {
                "const": "kernel"
              }
            },
            "required": [
              "vocabularyTier"
            ]
          },
          "then": {
            "not": {
              "required": [
                "standardKind"
              ]
            }
          }
        }
      ]
    }
  }
}
